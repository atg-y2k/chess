{
  "name": "chess-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Play chess against Stockfish at any Elo with a live eval bar and coaching — an installable iPhone web app.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.1",
    "@preact/signals": "^2.11.2",
    "chess.js": "^1.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
